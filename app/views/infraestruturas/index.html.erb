<div class="min-h-screen" style="background-color: #0f172a; font-family: 'Inter', system-ui, sans-serif;">

  <!-- Header -->
  <div class="p-6 pb-0">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold" style="color: #ffffff; margin-bottom: 4px;">Infraestrutura</h1>
        <p class="text-sm" style="color: #94a3b8;">Monitoramento dos servidores e recursos de infraestrutura.</p>
      </div>
      <div class="flex items-center gap-3">
        <span style="display: flex; align-items: center; gap: 6px; padding: 6px 12px; font-size: 12px; color: #22c55e; background-color: rgba(34, 197, 94, 0.1); border-radius: 8px;">
          <span style="width: 8px; height: 8px; background-color: #22c55e; border-radius: 50%; display: inline-block;"></span>
          <%= @hosts.count { |h| h[:status] == "Ativo" } %> operacionais
        </span>
        <%= link_to request.path, style: "display: flex; align-items: center; gap: 8px; padding: 8px 16px; font-size: 13px; color: #ffffff; background-color: #2563eb; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; text-decoration: none;" do %>
          <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Atualizar
        <% end %>
      </div>
    </div>
  </div>

  <!-- Cards de resumo -->
  <div class="p-6">
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
      <div style="background-color: #1e293b; border-radius: 12px; padding: 20px; border: 1px solid #1e293b;">
        <span style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">Total Servidores</span>
        <div style="margin-top: 8px;"><span style="font-size: 32px; font-weight: 700; color: #ffffff;"><%= @hosts.size %></span></div>
        <div style="margin-top: 12px; height: 4px; background-color: #0f172a; border-radius: 9999px; overflow: hidden;">
          <div style="height: 100%; background-color: #22c55e; border-radius: 9999px; width: 100%;"></div>
        </div>
      </div>
      
      <% # Cálculos para os resumos %>
      <% avg_cpu = @hosts.map { |h| h[:cpu].to_f }.sum / @hosts.size.to_f rescue 0 %>
      <% avg_mem = @hosts.map { |h| h[:mem_used].to_f }.sum / @hosts.size.to_f rescue 0 %>
      <% avg_uptime = @hosts.map { |h| h[:uptime].to_f }.sum / @hosts.size.to_f rescue 0 %>

      <div style="background-color: #1e293b; border-radius: 12px; padding: 20px; border: 1px solid #1e293b;">
        <span style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">CPU Média</span>
        <div style="margin-top: 8px;"><span style="font-size: 32px; font-weight: 700; color: #ffffff;"><%= avg_cpu.round(1) %><span style="font-size: 16px; color: #94a3b8;">%</span></span></div>
        <div style="margin-top: 12px; height: 4px; background-color: #0f172a; border-radius: 9999px; overflow: hidden;">
          <div style="height: 100%; background-color: <%= get_usage_color(avg_cpu) %>; border-radius: 9999px; width: <%= avg_cpu %>%;"></div>
        </div>
      </div>
      
      <div style="background-color: #1e293b; border-radius: 12px; padding: 20px; border: 1px solid #1e293b;">
        <span style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">Memória Média</span>
        <div style="margin-top: 8px;"><span style="font-size: 32px; font-weight: 700; color: #ffffff;"><%= avg_mem.round(1) %><span style="font-size: 16px; color: #94a3b8;">%</span></span></div>
        <div style="margin-top: 12px; height: 4px; background-color: #0f172a; border-radius: 9999px; overflow: hidden;">
          <div style="height: 100%; background-color: <%= get_usage_color(avg_mem) %>; border-radius: 9999px; width: <%= avg_mem %>%;"></div>
        </div>
      </div>
      
      <div style="background-color: #1e293b; border-radius: 12px; padding: 20px; border: 1px solid #1e293b;">
        <span style="font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500;">Uptime Médio</span>
        <div style="margin-top: 8px;"><span style="font-size: 32px; font-weight: 700; color: #ffffff;"><%= avg_uptime.round(1) %><span style="font-size: 16px; color: #94a3b8;">h</span></span></div>
        <div style="margin-top: 12px; height: 4px; background-color: #0f172a; border-radius: 9999px; overflow: hidden;">
          <div style="height: 100%; background-color: #22c55e; border-radius: 9999px; width: 100%;"></div>
        </div>
      </div>
    </div>

    <!-- Tabela de servidores -->
    <div style="background-color: #1e293b; border-radius: 12px; border: 1px solid #1e293b; overflow: hidden;">
      <div style="padding: 16px 24px; border-bottom: 1px solid #334155;">
        <h2 style="font-size: 16px; font-weight: 700; color: #ffffff; margin: 0;">Servidores</h2>
        <p style="font-size: 12px; color: #94a3b8; margin: 2px 0 0;">Status e uso de recursos de cada servidor da infraestrutura.</p>
      </div>

      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 1px solid #334155;">
            <th style="text-align: left; padding: 12px 24px; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Host</th>
            <th style="text-align: left; padding: 12px 16px; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Status</th>
            <th style="text-align: center; padding: 12px 16px; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">CPU (%)</th>
            <th style="text-align: center; padding: 12px 16px; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Memória Usada (%)</th>
            <th style="text-align: center; padding: 12px 16px; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Memória Total (MB)</th>
            <th style="text-align: center; padding: 12px 16px; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Uptime (h)</th>
          </tr>
        </thead>
        <tbody>
          <% @hosts.each do |host| %>
            <% cpu_val = host[:cpu].to_f rescue 0 %>
            <% mem_val = host[:mem_used].to_f rescue 0 %>
            <% mem_total_val = host[:mem_total].to_f rescue 0 %>
            <% uptime_val = host[:uptime].to_f rescue 0 %>

            <tr style="border-bottom: 1px solid #334155;">
              <td style="padding: 16px 24px; font-size: 14px; color: #e2e8f0; font-weight: 500;"><%= host[:name] %></td>
              <td style="padding: 16px 16px;">
                <span style="font-size: 12px; color: <%= get_status_color(host[:status]) %>; background-color: <%= get_status_color(host[:status]) %>1a; padding: 2px 8px; border-radius: 4px;">
                  <%= host[:status] %>
                </span>
              </td>
              
              <!-- Coluna CPU -->
              <td style="padding: 16px 16px; text-align: center;">
                <div style="display: flex; align-items: center; gap: 8px; justify-content: center;">
                  <span style="font-size: 13px; font-weight: 600; color: <%= get_usage_color(cpu_val) %>;"><%= host[:cpu] %></span>
                  <div style="width: 60px; height: 8px; background-color: #0f172a; border-radius: 9999px; overflow: hidden;">
                    <div style="height: 100%; background-color: <%= get_usage_color(cpu_val) %>; border-radius: 9999px; width: <%= safe_percentage(cpu_val) %>%;"></div>
                  </div>
                </div>
              </td>
              
              <!-- Coluna Memória Usada -->
              <td style="padding: 16px 16px; text-align: center;">
                <div style="display: flex; align-items: center; gap: 8px; justify-content: center;">
                  <span style="font-size: 13px; font-weight: 600; color: <%= get_usage_color(mem_val) %>;"><%= host[:mem_used] %></span>
                  <div style="width: 60px; height: 8px; background-color: #0f172a; border-radius: 9999px; overflow: hidden;">
                    <div style="height: 100%; background-color: <%= get_usage_color(mem_val) %>; border-radius: 9999px; width: <%= safe_percentage(mem_val) %>%;"></div>
                  </div>
                </div>
              </td>
              
              <!-- Coluna Memória Total -->
              <td style="padding: 16px 16px; text-align: center; font-size: 13px; color: #e2e8f0;">
                <%= host[:mem_total] %>
              </td>
              
              <!-- Coluna Uptime -->
              <td style="padding: 16px 16px; text-align: center; font-size: 13px; color: #e2e8f0;">
                <%= host[:uptime] %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Legenda -->
    <div style="display: flex; justify-content: center; gap: 24px; margin-top: 16px;">
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="width: 12px; height: 12px; background-color: #22c55e; border-radius: 2px; display: inline-block;"></span>
        <span style="font-size: 12px; color: #94a3b8;">Normal (0-30%)</span>
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="width: 12px; height: 12px; background-color: #f59e0b; border-radius: 2px; display: inline-block;"></span>
        <span style="font-size: 12px; color: #94a3b8;">Atenção (30-70%)</span>
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="width: 12px; height: 12px; background-color: #ef4444; border-radius: 2px; display: inline-block;"></span>
        <span style="font-size: 12px; color: #94a3b8;">Crítico (70-100%)</span>
      </div>
    </div>
  </div>

</div>
