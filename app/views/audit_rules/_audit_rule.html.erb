<div id="<%= dom_id audit_rule %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= audit_rule.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= audit_rule.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Severity:</strong>
    <%= audit_rule.severity %>
  </div>
</div>
